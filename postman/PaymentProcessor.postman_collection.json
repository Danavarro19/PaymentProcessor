              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": \"\",\n    \"customerId\": \"\",\n    \"amount\": 0,\n    \"currency\": \"usd\",\n    \"timestamp\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
